# Local environment. Both prisma.config.ts and lib/prisma.ts fall back to
# file:./prisma/dev.db, so a fresh clone works without this file.
.env

# SQLite database file — local state, rebuilt with `prisma migrate dev` + seed.
# The migrations themselves ARE tracked.
prisma/*.db
prisma/*.db-journal
