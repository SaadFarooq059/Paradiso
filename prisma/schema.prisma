// Paradiso CRM persistence layer.
//
// This schema is a direct translation of the shapes that already existed in
// lib/types.ts and lib/mock-data.ts, so behaviour on every screen is unchanged —
// only the storage location moves. Where the in-memory model leaned on a
// module-level constant (INITIAL_STOCK) to derive a number, that number is now a
// real column instead, because a persisted restock can push stock above its seed
// value and the derived version silently went wrong (see StockLevel.capacity).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved connection URLs out of the schema: the URL now lives in
// prisma.config.ts for CLI/migrate, and the running client gets a driver adapter.
// Postgres rather than SQLite because SQLite is a file on local disk, and a
// hosted deploy has no durable local disk to put it on.
datasource db {
  provider = "postgresql"
}

/// Where a wedding or bespoke order has got to.
///
/// A separate lifecycle from OrderStatus on purpose. Enquiry, Quoted and Lost
/// have no equivalent for a counter order, and a wedding is never converted
/// into one — it books kitchen capacity directly through the same
/// ProductionLine seam the projection already speaks.
enum WeddingStage {
  Enquiry
  Quoted
  DepositPaid  @map("Deposit paid")
  Confirmed
  InProduction @map("In production")
  Delivered    @map("Delivered or collected")
  Completed
  Cancelled
  Lost
}

/// At what stage a wedding starts holding ingredients and production capacity.
///
/// Deliberately a setting rather than a constant: the shop will have a view on
/// it, and welding it in would make that view a code change.
enum WeddingCapacityStage {
  AtQuote        @map("At quote")
  AtDeposit      @map("At deposit")
  AtConfirmation @map("At final confirmation")
}

/// What a staff member is allowed to do.
///
/// Enforced on the API routes by the capability matrix in lib/auth/roles.ts.
/// Hiding a nav item is not protection: the route behind it is still reachable
/// by anyone who knows the path.
enum StaffRole {
  Admin
  Manager
  Kitchen
  ShopFloor @map("Shop-floor")
}

/// The order's position in the fulfilment lifecycle — exactly one at a time.
///
/// Deliberately does NOT carry payment. "Payment received" and "Refunded" are a
/// second, independent dimension (see Order.amountPaid/amountRefunded and
/// PaymentEvent): an order can be paid *and* in production, and a refund can
/// follow collection without un-collecting it.
///
/// Which of these book ingredients is decided in one place —
/// LIVE_STATUSES in lib/stock-projection.ts — because demand is derived from
/// live orders rather than stored. Confirmed is deliberately NOT live: details
/// are agreed but no oven capacity is held until Schedule runs the feasibility
/// check.
///
/// Labels keep the client's own wording; the member names are the identifiers
/// Prisma needs. serialize.ts maps between the two in one place.
enum OrderStatus {
  Confirmed
  Scheduled
  InProduction         @map("In Production")
  ReadyForCollection   @map("Ready for collection")
  CollectedOrDelivered @map("Collected or delivered")
  /// Blocked on the customer, not on stock — resolved by asking them, not by
  /// re-checking the store cupboard. Kept distinct from OnHold so `shortages`
  /// and the Re-check action keep meaning exactly one thing.
  AwaitingDetails      @map("Details require clarification")
  /// Blocked on stock. Carries `shortages`; resolved by Re-check.
  OnHold               @map("On Hold")
  Cancelled
}

/// Money moving in or out. Amounts are always positive; `kind` gives direction.
enum PaymentEventKind {
  Payment
  Refund
}

/// Which customer message a rendered email is.
enum EmailTemplate {
  Confirmation
  Reminder
  ReadyForCollection @map("Ready for collection")
  FollowUp           @map("Follow-up")
}

/// Nothing is actually sent yet, so this records what *would* happen.
enum EmailStatus {
  /// Would go out now.
  ReadyToSend @map("Ready to send")
  /// Date-triggered (the reminder) and not due yet — sendAfter says when.
  Pending
  /// Cannot go out; `suppressedReason` says why (no address, order cancelled).
  Suppressed
}

/// One of the five ingredients. `key` matches IngredientKey in lib/types.ts
/// ("eggs" | "mascarpone" | "savoiardi" | "coffee" | "butter") and stays the
/// stable identifier the UI and API speak in; the numeric id is internal.
model Ingredient {
  id        Int    @id @default(autoincrement())
  key       String @unique
  label     String
  /// "" for countable items (eggs), "g" / "ml" otherwise.
  unit      String
  /// Display order on the Stock Levels and Restock screens (INGREDIENT_ORDER).
  sortOrder Int

  stockLevel  StockLevel?
  recipeItems RecipeItem[]
  restocks    RestockEntry[]

  @@map("ingredients")
}

/// A sellable product (Mini / Grande / Suprema Classico).
model ProductVariant {
  id            String  @id
  name          String
  description   String
  servings      String
  /// Soft delete: the Recipes screen can remove a variant, but orders that
  /// already reference it must keep rendering their product name and history.
  archived      Boolean @default(false)
  /// Display position on the New Order and Recipes screens. Same reason as
  /// Staff.sortOrder: the in-memory array had an order (Mini, Grande, Suprema)
  /// that the New Order form also used to pick its default selection, and row
  /// order out of a database is arbitrary without an explicit column.
  sortOrder     Int     @default(0)
  /// Working days needed between starting production and handing the order over.
  /// productionDate = collectionDate - leadTimeDays, derived on read rather than
  /// stored, so changing a recipe's lead time re-plans orders that have not been
  /// made yet. Note this is deliberately NOT frozen per order the way
  /// consumedIngredients is: that snapshot records what was physically used and
  /// must never move, whereas a lead time is a forward-looking plan.
  leadTimeDays  Int     @default(2)
  /// How many finished units one batch produces. The kitchen works in batches,
  /// not units — one batch makes two 12-inch cakes whether one was ordered or
  /// two — so ingredient demand is batches x the batch recipe, never units x a
  /// per-unit recipe. Named unitsPerBatch rather than `yield` because that word
  /// is awkward to destructure in JS.
  unitsPerBatch Int     @default(1)
  /// PLACEHOLDER PRICE, in pence. The client has not supplied real prices, the
  /// same way they had not supplied batch yields — these are plausible numbers
  /// so totals and refunds have something to work from, and the Recipes screen
  /// labels them as placeholder. Integer pence, never a float: 0.1 + 0.2 is not
  /// 0.3 and money must not be approximate.
  priceAmount   Int     @default(0)

  recipeItems RecipeItem[]
  orderItems  OrderItem[]
  quoteTiers  QuoteTier[]

  @@map("product_variants")
}

/// Single-row table of the shop's calendar rules. These are settings rather than
/// constants because the client has said they will change — blocked days and the
/// opening time in particular — and changing them must not need a deploy.
/// Enforced as a singleton by pinning the id to 1.
model CalendarSettings {
  id                        Int                  @id @default(1)
  /// Weekday numbers that cannot be chosen for collection, using JavaScript's
  /// getDay() convention (0 = Sunday ... 6 = Saturday). Seeded as [1] — the shop
  /// does not do Monday collections. A real integer array on Postgres; on SQLite
  /// this had to be a JSON string that the application parsed by hand.
  blockedWeekdays           Int[]                @default([1])
  /// Earliest time of day an order can be collected, as "HH:mm" in 24-hour form.
  earliestCollectionTime    String               @default("10:30")
  /// Ceiling on how many orders may share one production day. A future
  /// constraint rather than a current one, so it is seeded deliberately high.
  maxOrdersPerProductionDay Int                  @default(20)
  /// Shop identity, used by the customer email templates. Here rather than
  /// hardcoded in a template so the Calendar Rules screen can edit it without a
  /// deploy — the same reasoning that moved the calendar rules out of code.
  shopName                  String               @default("Paradiso")
  shopAddress               String               @default("")
  shopPhone                 String               @default("")
  /// At what stage a wedding starts holding ingredients and production capacity.
  /// A setting rather than a constant: the shop will have a view on it, and
  /// welding it in would make that view a code change.
  weddingCapacityStage      WeddingCapacityStage @default(AtDeposit)
  /// PLACEHOLDER deposit percentage, applied to a quote total.
  weddingDepositPercent     Int                  @default(25)

  @@map("calendar_settings")
}

/// One line of a product's recipe: how much of one ingredient ONE BATCH needs.
/// Together these rows are the `requires` map from ProductVariant in lib/types.ts.
model RecipeItem {
  id             Int    @id @default(autoincrement())
  variantId      String
  ingredientId   Int
  /// Amount needed to make one whole batch, in the ingredient's unit. This used
  /// to be per single unit; the figures did not change, their meaning did. A
  /// Suprema batch has always drawn 6 eggs — what changed is that the batch now
  /// yields 2 cakes rather than being assumed to yield exactly the one ordered.
  amountPerBatch Float

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredient Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([variantId, ingredientId])
  @@map("recipe_items")
}

/// Current stock for one ingredient.
model StockLevel {
  id           Int   @id @default(autoincrement())
  ingredientId Int   @unique
  /// What is physically in the building. Only a restock moves this: under the
  /// dated ledger, scheduling an order records demand against its production day
  /// rather than deducting here, and cancelling simply removes that demand again.
  ///
  /// The `capacity` column this model used to carry is gone. It existed to hold
  /// the total ever brought in, because `available` was being eaten by orders;
  /// now that orders leave it alone the two are the same number, and "committed"
  /// is derived from live orders' demand instead of from the gap between them.
  onHand       Float

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("stock_levels")
}

/// A staff member. Doubles as the login identity (dummy auth picks one of these).
model Staff {
  id           String    @id
  name         String
  /// Which capabilities this person has. A real column with a real enum, so the
  /// database refuses a role the application does not know about.
  role         StaffRole
  /// Sign-in identity. Unique because it is what someone types to log in, and
  /// two people sharing one would make "who did this" unanswerable.
  email        String    @unique
  /// bcrypt, cost 12. Never plaintext and never reversible — the only operations
  /// are "hash this" and "does this match".
  passwordHash String
  /// A suspended account keeps its history but cannot sign in. Deleting the row
  /// would orphan every status change and payment it is the actor for.
  active       Boolean   @default(true)
  /// Last successful sign-in, so the demo can show the accounts are real.
  lastSignInAt DateTime?
  /// Round-robin counter: orders CURRENTLY on this person's plate. Incremented on
  /// assignment, decremented when an order is cancelled, so it tracks live
  /// workload rather than lifetime assignments.
  orderCount   Int       @default(0)
  /// Tie-break position for round-robin. In-memory this was free — the roster was
  /// a JS array and a stable sort on orderCount preserved its order. A database
  /// returns no guaranteed row order, so without an explicit column two staff on
  /// an equal count could be picked in either order between runs.
  sortOrder    Int       @default(0)

  assignments        ProductionAssignment[]
  statusChanges      OrderStatusEvent[]
  paymentEvents      PaymentEvent[]
  weddingStageEvents WeddingStageEvent[]
  quotes             Quote[]

  @@map("staff")
}

/// A customer order. Single-product in the UI today, but the line items live in
/// OrderItem so a multi-product order needs no schema change.
model Order {
  id                  String      @id @default(uuid())
  collectionDate      DateTime
  status              OrderStatus
  /// This order's share of the batch it is made in, frozen at the moment it was
  /// scheduled ({ eggs: 3, mascarpone: 250, ... }). Empty for orders that never
  /// scheduled. Never recomputed from the live recipe, and never rewritten when
  /// another order joins the same batch. Real jsonb on Postgres; on SQLite it was
  /// a String the application JSON.parse'd on every read.
  consumedIngredients Json        @default("{}")
  /// Why an order is On Hold: [{ ingredient, shortBy }].
  shortages           Json        @default("[]")
  createdAt           DateTime    @default(now())

  /// Order total in pence, frozen at creation from the variant's price the same
  /// way consumedIngredients freezes the recipe: repricing a product must not
  /// silently restate what an existing customer was charged.
  totalAmount    Int @default(0)
  /// Sums of the PaymentEvent ledger, kept on the row so every read does not
  /// have to aggregate. The ledger is the source of truth; these are derived
  /// from it in one place (recordPayment / recordRefund) and never set directly.
  amountPaid     Int @default(0)
  amountRefunded Int @default(0)

  /// Nullable because orders taken before customers existed have none. The API
  /// requires one for new orders.
  customerId String?

  customer      Customer?             @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusEvent[]
  payments      PaymentEvent[]
  emails        EmailMessage[]
  assignment    ProductionAssignment?

  @@index([customerId])
  @@map("orders")
}

/// Who an order is for. A model rather than flat columns on Order because the
/// client's document goes on to ask for customer accounts, favourites and
/// repeat ordering, all of which need an identity to hang off.
model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())

  orders   Order[]
  weddings Wedding[]

  /// Not unique: the same household may order under one address, and enforcing
  /// uniqueness here would reject that without a merge flow to fall back on.
  @@index([email])
  @@map("customers")
}

/// Every movement of money, so "refunded partially" has an amount and a date
/// rather than being a flag. The client's reporting asks for refunds by month,
/// which a single column on Order cannot answer.
/// Every movement of money, for an order OR a wedding.
///
/// One ledger, not two. Exactly one of orderId/weddingId is set, enforced by a
/// database CHECK rather than by convention — a polymorphic subjectType/subjectId
/// pair would have thrown away foreign-key integrity to save a column.
model PaymentEvent {
  id        Int              @id @default(autoincrement())
  orderId   String?
  weddingId String?
  kind      PaymentEventKind
  /// Always positive, in pence. Direction comes from `kind`.
  amount    Int
  at        DateTime         @default(now())
  /// Who recorded it. Null for anything written before actors were tracked.
  actorId   String?
  note      String?

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wedding Wedding? @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  actor   Staff?   @relation(fields: [actorId], references: [id])

  @@index([orderId])
  @@index([weddingId])
  @@map("payment_events")
}

/// A customer message that has been rendered but not sent. Nothing leaves the
/// building yet: the row records exactly what the customer would receive and
/// when, so the behaviour can be agreed before a mail provider is chosen.
model EmailMessage {
  id                 Int           @id @default(autoincrement())
  orderId            String
  template           EmailTemplate
  status             EmailStatus
  toName             String
  toEmail            String
  subject            String
  body               String
  renderedAt         DateTime      @default(now())
  /// When this would actually go out. Null means "immediately on render".
  /// The reminder is date-triggered rather than status-triggered, so it is the
  /// only one that normally carries a future value.
  sendAfter          DateTime?
  suppressedReason   String?
  /// The status change that produced this message, where one did.
  triggeredByEventId Int?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("email_messages")
}

/// One product line on an order.
model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   String
  variantId String
  quantity  Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

/// One entry in an order's lifecycle timeline, rendered on Order Detail.
model OrderStatusEvent {
  id      Int         @id @default(autoincrement())
  orderId String
  status  OrderStatus
  at      DateTime    @default(now())
  note    String?
  /// Who moved it. Null means the change predates actor tracking — not
  /// "the system": an unknown author is recorded as unknown rather than guessed.
  actorId String?

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor Staff? @relation(fields: [actorId], references: [id])

  @@index([orderId])
  @@map("order_status_events")
}

/// Which staff member is producing an order. One per order (the UI assigns a
/// single owner), modelled as its own table so the assignment can carry its own
/// timestamp and be released on cancellation without mutating the order row.
model ProductionAssignment {
  id         Int       @id @default(autoincrement())
  orderId    String    @unique
  staffId    String
  assignedAt DateTime  @default(now())
  /// Set when the order is cancelled: the assignment stays as a historical record
  /// (Order Detail still shows who had it) but stops counting toward workload.
  releasedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("production_assignments")
}

/// Audit trail for the Restock screen's log.
model RestockEntry {
  id           String   @id @default(uuid())
  ingredientId Int
  amount       Float
  at           DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("restock_entries")
}

/// A named wedding package. Seeded with plausible placeholders — the client has
/// not given us real prices, the same standing as the batch yields.
model WeddingPackage {
  id          String   @id
  name        String
  description String
  /// PLACEHOLDER base price, in pence.
  basePrice   Int
  /// What the package includes, one line each.
  includes    String[]
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  quotes Quote[]

  @@map("wedding_packages")
}

/// A wedding or bespoke order.
///
/// Never becomes an Order. Putting venue, guest count and dietary requirements
/// on Order would make them nullable on every counter tiramisù ever sold, and
/// the lifecycles genuinely differ. It books capacity directly instead.
model Wedding {
  id        String       @id @default(uuid())
  /// Human-readable, for talking to the customer about it.
  reference String       @unique
  stage     WeddingStage @default(Enquiry)

  customerId String

  /// The day of the event. Stored as a shop-time moment, like a collection date.
  eventDate           DateTime
  venue               String
  guestCount          Int
  /// Free text for now; the client has not given us a flavour list.
  flavourNotes        String   @default("")
  dietaryRequirements String   @default("")
  notes               String   @default("")

  /// People and vehicles the event needs. Both are named in the client's document.
  staffRequired   Int @default(0)
  driversRequired Int @default(0)

  /// The quote currently in force. Amendments create a new version and move this.
  currentQuoteId String? @unique

  /// When this wedding started holding kitchen capacity.
  ///
  /// STORED, not derived from (stage, setting). That is the whole point: if it
  /// were derived, tightening weddingCapacityStage would silently un-book every
  /// wedding that had already committed, and the kitchen would over-sell stock
  /// it had already promised. Once set, only cancelling clears it.
  capacityBookedAt DateTime?

  /// When the remaining balance is due. Null until there is a quote.
  balanceDueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id])
  currentQuote Quote?              @relation("CurrentQuote", fields: [currentQuoteId], references: [id])
  quotes       Quote[]             @relation("WeddingQuotes")
  payments     PaymentEvent[]
  loans        EquipmentLoan[]
  stageHistory WeddingStageEvent[]

  @@index([customerId])
  @@index([eventDate])
  @@map("weddings")
}

/// One version of what was agreed.
///
/// Amendments write a new version and supersede the old one; nothing is ever
/// updated in place, so "what did we agree in March" stays answerable. The tiers
/// hang off the quote rather than the wedding for the same reason — changing the
/// cake changes the quote.
model Quote {
  id        String  @id @default(uuid())
  weddingId String
  version   Int
  packageId String?

  /// All in pence, frozen at this version.
  basePrice   Int
  /// [{ label, amount }] — named adjustments, positive or negative.
  adjustments Json @default("[]")
  total       Int
  /// The guest count this version was costed for.
  guestCount  Int

  note         String?
  createdAt    DateTime  @default(now())
  actorId      String?
  /// Set when a later version replaces this one.
  supersededAt DateTime?

  wedding    Wedding         @relation("WeddingQuotes", fields: [weddingId], references: [id], onDelete: Cascade)
  currentFor Wedding?        @relation("CurrentQuote")
  package    WeddingPackage? @relation(fields: [packageId], references: [id])
  actor      Staff?          @relation(fields: [actorId], references: [id])
  tiers      QuoteTier[]

  @@unique([weddingId, version])
  @@index([weddingId])
  @@map("wedding_quotes")
}

/// A tier of the cake, as a quantity of an existing product variant.
///
/// Reusing ProductVariant is what lets a wedding feed the same batching and
/// stock projection as everything else — a tier is units of a recipe, which is
/// exactly what a ProductionLine is made of.
model QuoteTier {
  id        Int    @id @default(autoincrement())
  quoteId   String
  variantId String
  quantity  Int
  /// "Bottom tier", "Cutting cake" — what the kitchen calls it.
  label     String @default("")

  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([quoteId])
  @@map("wedding_quote_tiers")
}

/// Trays and cake stands out on loan. Explicitly in the client's document.
model EquipmentLoan {
  id         Int       @id @default(autoincrement())
  weddingId  String
  item       String
  quantity   Int       @default(1)
  outAt      DateTime?
  returned   Boolean   @default(false)
  returnedAt DateTime?
  note       String?

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@map("equipment_loans")
}

/// Every stage a wedding has been through, and who moved it.
model WeddingStageEvent {
  id        Int          @id @default(autoincrement())
  weddingId String
  stage     WeddingStage
  at        DateTime     @default(now())
  note      String?
  actorId   String?

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  actor   Staff?  @relation(fields: [actorId], references: [id])

  @@index([weddingId])
  @@map("wedding_stage_events")
}
